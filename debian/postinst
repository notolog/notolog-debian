#DEBHELPER#

if [ "${1:-}" = "configure" ]; then
    printf 'Installation completed.\n\n'

    if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
        printf '\033[94m'
        printf '▒█▄░▒█ ▒█▀▀▀▄ ▀▀█▀▀ ▒█▀▀▀▄ ▒█░░░ ▒█▀▀▀▄ ▒█▀▀█░\n'
        printf '\033[95m'
        printf '▒█▒█▒█ ▒█░░▒█ ░▒█░░ ▒█░░▒█ ▒█░░░ ▒█░░▒█ ▒█░░▄▄\n'
        printf '\033[91m'
        printf '▒█░░▀█ ▒█▄▄▄█ ░▒█░░ ▒█▄▄▄█ ▒█▄▄▄ ▒█▄▄▄█ ▒█▄▄▄█\n'
        printf '\033[0m\n'
    fi
fi

exit 0
